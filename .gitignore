# Real credentials live only on the server — copy config.example.php to config.php there.
admin/inc/config.php
# Ligação à folha Google (token) — copie sheet_config.example.php para sheet_config.php no servidor.
admin/inc/sheet_config.php
# Cache das leituras da folha.
admin/inc/cache/
.DS_Store
*.log

# Licensed font files (Futura Now Headline, Monotype) are deployed to the server only, never committed.
assets/fonts/
# Cloudflare R2 (Drive) — copie r2_config.example.php para r2_config.php no servidor.
admin/inc/r2_config.php
# Assistente do Drive (chave da Anthropic) — copie ai_config.example.php para ai_config.php no servidor.
admin/inc/ai_config.php
# Integrações das reuniões (Google Meet, Discord) — copie meet_config.example.php para meet_config.php no servidor.
admin/inc/meet_config.php
# Fotos de perfil (Equipa): ficam só no servidor.
admin/inc/avatars/
admin/inc/billing/
# Centro Criativo (IA de qualidade máxima e embeddings) — copie cc_config.example.php para cc_config.php no servidor.
admin/inc/cc_config.php
# Ficheiros do Centro Criativo quando o Drive (R2) não está ligado.
admin/inc/cc_files/
